{
  "name": "finno",
  "version": "0.1.0",
  "private": true,
  "repository": {
    "url": "git@github.com:AlexandreOliver/finno.git"
  },
  "scripts": {
    "dev": "pnpm service:db:up && pnpm wait-for-database && pnpm run db:push && pnpm db:seed && next dev",
    "dev:web": "next dev",
    "test:all": "pnpm service:db:up && pnpm wait-for-database && concurrently --names n,j --hide n --kill-others --success command-jest 'next dev' 'jest --runInBand' ",
    "test:back": "pnpm service:db:up && jest --runInBand",
    "test:watch": "pnpm service:db:up && jest --runInBand --watch",
    "build": "next build && pnpm db:push && pnpm db:seed",
    "lint": "eslint",
    "lint:tsc": "pnpm tsc --noEmit",
    "service:db:up": "docker compose -f src/infrastructure/compose.yaml up -d",
    "service:db:down": "docker compose -f src/infrastructure/compose.yaml down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "pnpm service:db:up && drizzle-kit studio",
    "db:seed": "node -r esbuild-register src/infrastructure/scripts/seed.ts",
    "db:view": "drizzle-lab visualizer",
    "wait-for-database": "node src/infrastructure/scripts/wait-for-database.js",
    "commit": "cz",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@lukemorales/query-key-factory": "^1.3.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "5.101.4",
    "@teispace/next-themes": "^2.0.4",
    "async-retry": "^1.3.3",
    "bcrypt": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "1.0.0-rc.4",
    "drizzle-zod": "^0.8.3",
    "lodash": "^4.18.1",
    "lucide-react": "^1.26.0",
    "next": "16.2.11",
    "pg": "^8.22.0",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.14.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "uuid": "^14.0.1",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@jest/globals": "^30.4.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@tanstack/eslint-plugin-query": "^5.101.4",
    "@types/async-retry": "^1.4.9",
    "@types/bcrypt": "^6.0.0",
    "@types/lodash": "^4.17.24",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^10.0.4",
    "cz-conventional-changelog": "^3.3.0",
    "dotenv": "^17.4.2",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-lab": "^0.11.0",
    "esbuild-register": "^3.6.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.2.11",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}
